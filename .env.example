# Vercel → Settings → Environment Variables
# Key талбарт зөвхөн үсэг, тоо, доогуур зураас (_) — TAB эсвэл зай бүү оруул

# ── Заавал ────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/cyberphysics

NEXTAUTH_SECRET=your-long-random-secret
JWT_SECRET=same-as-nextauth-secret-optional

# Vercel дээр localhost БҮТЭЭХГҮЙ — build алдаа гарна
NEXTAUTH_URL=https://newcybert-rjky.vercel.app
NEXT_PUBLIC_APP_URL=https://newcybert-rjky.vercel.app

ADMIN_EMAIL=admin@gmail.com
ADMIN_PASS=your-admin-password

# ── Имэйл илгээх (бүртгэл баталгаажуулах) — нэвтрэх биш ─────
GMAIL_USER=your@gmail.com
GMAIL_PASS=gmail-app-password

# ── Cloudinary (видео upload) ─────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_PRESET=your-preset
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Төлбөр (Premium) — production ───────────────────────────
# qpay = QR дэлгэц дээр (Khan Bank апп-аар уншина) · khan_bank = Khan хуудас руу redirect
PAYMENT_PROVIDER=qpay

# QPay V2 — https://merchant.qpay.mn (эсвэл sandbox: merchant-sandbox.qpay.mn)
QPAY_BASE_URL=https://merchant.qpay.mn
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_RECEIVER_CODE=terminal
QPAY_CALLBACK_URL=https://YOUR_DOMAIN/api/payment/callback/qpay

# Khan Bank E-Commerce — merchant@khanbank.com, KHAN MERCHANT app
KHANBANK_ENDPOINT=https://ecommerce.khanbank.com/payment/rest
KHANBANK_USERNAME=
KHANBANK_PASSWORD=
KHANBANK_LANGUAGE=mn
