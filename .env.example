# Copy to .env.local (local) and set the same keys in Vercel → Project → Settings → Environment Variables

# MongoDB (required)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/cyberphysics

# NextAuth (required for login)
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=https://your-app.vercel.app

# Google OAuth (optional — hide Google button if unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public app URL (recommended on Vercel — used for metadata & callbacks)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Cloudinary (video/PDF uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
