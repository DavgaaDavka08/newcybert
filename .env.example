# Vercel → Settings → Environment Variables
# Key талбарт зөвхөн үсэг, тоо, доогуур зураас (_) — TAB эсвэл зай бүү оруул

# ── Заавал ────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/cyberphysics

NEXTAUTH_SECRET=your-long-random-secret
JWT_SECRET=same-as-nextauth-secret-optional

NEXTAUTH_URL=https://newcybert-rjky.vercel.app
NEXT_PUBLIC_APP_URL=https://newcybert-rjky.vercel.app

ADMIN_EMAIL=admin@gmail.com
ADMIN_PASS=your-admin-password

# ── Имэйл илгээх (бүртгэл баталгаажуулах) — нэвтрэх биш ─────
GMAIL_USER=your@gmail.com
GMAIL_PASS=gmail-app-password

# ── Cloudinary (видео upload) ─────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_PRESET=your-preset
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
