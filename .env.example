# Copy to .env.local (local) and set the same keys in Vercel → Settings → Environment Variables

# MongoDB (required for student/teacher accounts)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/cyberphysics

# NextAuth (REQUIRED on Vercel — login will fail without these)
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=https://newcybert-rjky.vercel.app

# Public app URL (metadata, emails)
NEXT_PUBLIC_APP_URL=https://newcybert-rjky.vercel.app

# Admin login (credentials — works without MongoDB)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASS=TCB-757

# Google OAuth — add this redirect URI in Google Cloud Console:
# https://newcybert-rjky.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (video/PDF uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
