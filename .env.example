# ═══════════════════════════════════════════════════════════════
# Vercel → Settings → Environment Variables
# Production + Preview хоёуланд ижил утга өгнө. Дараа нь Redeploy.
# ═══════════════════════════════════════════════════════════════

# ── ЗААВАЛ (нэвтрэлт) ─────────────────────────────────────────
# JWT_SECRET эсвэл NEXTAUTH_SECRET — хоёрыг нэгийг л тохируулна (ижил утга байж болно)
NEXTAUTH_SECRET=your-long-random-secret-here
# JWT_SECRET=same-as-above-if-you-prefer-this-name

NEXTAUTH_URL=https://newcybert-rjky.vercel.app
NEXT_PUBLIC_APP_URL=https://newcybert-rjky.vercel.app

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/cyberphysics

# Admin нэвтрэлт (имэйл/нууц — Google биш)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASS=your-admin-password

# ── Google нэвтрэлт (сонголттой) ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Console → Authorized redirect URI:
# https://newcybert-rjky.vercel.app/api/auth/callback/google

# ── Имэйл (нууц үг сэргээх, баталгаажуулалт) ─────────────────
GMAIL_USER=your@gmail.com
GMAIL_PASS=your-gmail-app-password

# ── Cloudinary (видео/PDF upload) ─────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_PRESET=your-upload-preset
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
